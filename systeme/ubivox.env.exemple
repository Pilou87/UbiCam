# Annonces vocales UbiVox : à copier en /etc/dvgrab-web/ubivox.env (droits 600)
# Base du service vocal : l'appli y ajoute /voice/<phrase> et envoie le jeton en en-tête.
UBIVOX_URL=http://192.168.xxx.xxx:8086
# Jeton WEBHOOK_TOKEN du .env d'UbiHome (ne pas le recopier ailleurs).
WEBHOOK_TOKEN=a_remplir
