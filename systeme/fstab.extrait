# Ligne à ajouter au /etc/fstab du conteneur : le partage DV-CAM du NAS, où vont les captures
# Remplacer 192.168.xxx.xxx par l'adresse du NAS avant l'installation
//192.168.xxx.xxx/DV-CAM /mnt/nas-dvcam cifs credentials=/etc/dvgrab-web/nas.cred,uid=0,gid=0,file_mode=0664,dir_mode=0775,vers=3.0,_netdev,nofail,x-systemd.after=network-online.target,x-systemd.mount-timeout=30 0 0
